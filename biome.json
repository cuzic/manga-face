{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {"enabled": true, "clientKind": "git", "useIgnoreFile": true},
	"files": {"includes": ["src/**", "test/**", "tools/**", "!**/*.svg"]},
	"formatter": {"enabled": false},
	"assist": {"actions": {"source": {"organizeImports": "off"}}},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {"noUnusedImports": "error", "noUnusedVariables": "error", "noUnusedFunctionParameters": "error"},
			"style": {"useImportType": "error", "noNonNullAssertion": "error", "useTemplate": "off"},
			"suspicious": {"noExplicitAny": "error", "useIterableCallbackReturn": "off", "noAssignInExpressions": "off"},
			"complexity": {"noCommaOperator": "off", "useLiteralKeys": "off"}
		}
	},
	"overrides": [
		{"includes": ["test/**", "tools/**"], "linter": {"rules": {"suspicious": {"noExplicitAny": "off", "noImplicitAnyLet": "off"}, "style": {"noNonNullAssertion": "off"}}}},
		{"includes": ["src/face.ts"], "linter": {"rules": {"style": {"noNonNullAssertion": "off"}, "suspicious": {"noExplicitAny": "off", "noApproximativeNumericConstant": "off"}}}}
	]
}
